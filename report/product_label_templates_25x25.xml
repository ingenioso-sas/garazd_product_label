<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="label_25x25x1">
        <table class="table table-bordered" style="width: 100%; height: 100%; margin: 0 !important; padding: 0 !important; font-family: 'Lato-Bol'; table-layout: fixed;">
            <tr style="border:0;margin:0;padding:0;">
                <td class="text-center" style="border:0;margin:0;padding:0;width:100%;height:100%;vertical-align: middle;">
                    <div style="overflow: hidden; height: 6.0mm; max-height: 6.0mm; font-size: 2.4mm; width: 100% !important; padding: 0; line-height: 2.8mm; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; word-break: break-all; overflow-wrap: break-word;">
                        <span t-field="label.product_id.name"/>
                        <span style="white-space: nowrap; display: inline;">(<span t-esc="label.product_id.get_cost_in_code()[:-3]"/>.<span t-esc="(label.write_date.strftime('%y0%m0%d'))"/>)</span>
                        <span t-if="label.product_id.product_template_attribute_value_ids" style="font-size: 2.0mm; display:inline; ">[<span t-field="label.product_id.product_template_attribute_value_ids"/>]</span>
                    </div>
                    <div style="width: 100%; padding: 0; margin: 0; font-weight: bold; font-size: 3.5mm; line-height: 4.0mm; height: 4.5mm; max-height: 4.5mm !important; overflow: hidden;">
						<div style="text-align: center;">
                            <span t-field="label.product_id.currency_id.symbol"/>
                            <span t-field="label.product_id.lst_price" style="font-size: 4.0mm; vertical-align: bottom;" />
                        </div>
                    </div>
                    <img alt="Barcode" t-if="label.product_id.barcode and len(label.product_id.barcode) == 13" t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('EAN13', label.product_id.barcode, 600, 180)" style="width:100%; height:8.0mm; max-height:8.0mm; object-fit: contain; padding:0px;" />
                    <img alt="Barcode" t-if="label.product_id.barcode and len(label.product_id.barcode) == 8" t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('EAN8', label.product_id.barcode, 600, 180)" style="width:100%; height:8.0mm; max-height:8.0mm; object-fit: contain; padding:0px;"/>
                    <div t-if="label.product_id.barcode" style="width: 100%; padding: 0; margin: 0; font-size: 2.2mm; height: 3.0mm; max-height: 3.0mm !important; overflow: hidden;">
                        <span t-field="label.product_id.barcode"/>
                    </div>
                </td>
            </tr>
        </table>
    </template>

    <template id="report_product_label_25x25x1_template">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <style>
                    body, body.container, .article, .page {
                        margin: 0 !important;
                        padding: 0 !important;
                        width: 100% !important;
                        max-width: 100% !important;
                    }
                </style>
                <t t-set="columns" t-value="columns or 1"/>
                <t t-set="rows" t-value="rows or 1"/>
                <t t-set="label_docs" t-value="docs or env['print.product.label.line'].browse(env.context.get('active_ids', []))"/>
                <t t-set="count" t-value="0" />
                <t t-set="total" t-value="columns * rows" />
                
                <div style="margin: 0 !important; padding: 0 !important;">
                    <t t-foreach="label_docs" t-as="label">
                        <t t-set="qty" t-value="1" />
                        <t t-if="label.qty">
                            <t t-set="qty" t-value="label.qty" />
                        </t>
                        <t t-foreach="list(range(qty))" t-as="index_qty">
                            <div t-if="count % total == 0 and count" style="page-break-after:always;"/>
                            <div t-if="count % columns == 0 and count" style="clear:both;"/>
                            <!-- Use exact mm physical sizes to match paperformat print area, prevents wkhtmltopdf viewport scaling bugs -->
                            <div class="page" t-attf-style="width: #{21.0 / columns}mm !important; height: #{22.6 / rows}mm !important; float: left; box-sizing: border-box; overflow: hidden; margin: 0 !important; padding: 0 !important;">
                                <t t-call="garazd_product_label.label_25x25x1"/>
                            </div>
                            <t t-set="count" t-value="count+1" />
                        </t>
                    </t>
                </div>
            </t>
        </t>
    </template>

</odoo>
