<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="label_25x25x1">
        <table class="table table-bordered col-xs-4"  style="margin-bottom: 0 !important; font-family: 'Lato-Bol';">
            <tr height="100%" style="border:0;margin:0;padding:0;">
                <td class="col-xs-4 text-center" style="border:0;margin:0;padding:0;">
                    <div style="overflow: hidden; max-height:60px; font-size: 0.8rem; width: 100% !important; padding: 0; line-height: 15px; display:inline; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 4; -ms-word-break: break-all; word-break: break-all; word-break: break-word; overflow-wrap: break-word; word-wrap: break-word; -ms-hyphens: auto; -webkit-hyphens: auto; -moz-hyphens: auto; hyphens: auto;">
                        <span t-field="label.product_id.name"/>
                        <span style="white-space: nowrap; display: inline;">(<span t-esc="label.product_id.get_cost_in_code()[:-3]"/>.<span t-esc="(label.write_date.strftime('%y0%m0%d'))"/>)</span>
                        <span t-if="label.product_id.product_template_attribute_value_ids" style="font-size: 11px; display:inline; ">[<span t-field="label.product_id.product_template_attribute_value_ids"/>]</span>
                    </div>
                    <div style="width: 100%; padding: 0; margin: 0; font-weight: bold; font-size: 20px; line-height: 24px; max-height: 25px !important; ">
						<div style="text-align: -webkit-right;">
                            <span t-field="label.product_id.currency_id.symbol"/>
                            <span t-field="label.product_id.lst_price" style="font-size: 26px; vertical-align: bottom;" />
                        </div>
                    </div>
                    <div t-if="label.product_id.default_code" style="width: 100%; padding: 0; margin: 0; font-size: 15px; max-height: 16px !important;"></div>
                    <img t-if="label.product_id.barcode" t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('EAN13', label.product_id.barcode, 600, 180)" style="width:100%;max-height:48px;padding:0px 0px;" />
                    <img alt="Barcode" t-if="label.product_id.barcode and len(label.product_id.barcode) == 8" t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('EAN8', label.product_id.barcode, 600, 180)" style="width:100%;height:48px;padding:0px 1px;"/>
                    <div t-if="label.product_id.barcode" style="width: 100%; padding: 0; margin: 0; font-size: 0.9em; max-height: 16px !important;">
                        <span t-field="label.product_id.barcode"/>
                    </div>
                </td>
            </tr>
        </table>
    </template>

    <template id="report_product_label_25x25x1_template">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <div class="oe_structure"/>
                <t t-foreach="docs" t-as="label">
                    <t t-set="qty" t-value="1" />
                    <t t-if="label.qty">
                        <t t-set="qty" t-value="label.qty" />
                    </t>
                    <t t-foreach="list(range(qty))" t-as="index_qty">
                        <div class="page" style="left: -15px; position: relative;">
                            <div style="width: 160px; margin: 0; height: 160px; max-height: 160px; padding: 0; border:solid 0px black;">
                                <t t-call="garazd_product_label.label_25x25x1"/>
                            </div>
                        </div>
                        <div style="clear:both;"/>
                        <div style="page-break-after:always;"/>
                    </t>
                </t>
            </t>
        </t>
    </template>

</odoo>
